PAYROLL_DB_SSL_ROOT_CERT=certs/supabase-root-2021-ca.crt
PAYROLL_DB_POOL_SIZE=4
PAYROLL_STORAGE_BUCKET=payroll-employee-photos
PAYROLL_INVITE_REDIRECT_URL=https://payroll.example.com/auth/set-password
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-github-username.github.io
