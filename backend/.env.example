HIKVISION_BRIDGE_TOKEN=change-this-long-random-token
HIKVISION_BRIDGE_BACKEND_URL=http://localhost:8080
HIKVISION_BRIDGE_CAMERA_URLS=http://10.10.4.101,http://10.10.4.102,http://10.10.4.103,http://10.10.4.104,http://10.10.4.105,http://10.10.4.106,http://10.10.4.107
HIKVISION_BRIDGE_INTERVAL_SECONDS=3
HIKVISION_BRIDGE_MAX_RESULTS=30
HIKVISION_BRIDGE_TIMEOUT_SECONDS=10
ZKTECO_ADMS_COMM_KEY=
ZKTECO_TIME_ZONE=Asia/Colombo
ZKTECO_ADMS_DELAY_SECONDS=10
ZKTECO_ADMS_SERVER_VERSION=GarmentLine-ZKTeco-ADMS
